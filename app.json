{
  "expo": {
    "name": "BR Fincas",
    "slug": "app-finca",
    "version": "0.1.0",
    "scheme": "app-finca-corbana",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corbana.appfinca",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "La app guarda tu recorrido durante la precalibración aunque bloquees el teléfono.",
        "NSLocationWhenInUseUsageDescription": "La app usa tu ubicación para registrar dónde se toma cada racimo de la precalibración.",
        "NSCameraUsageDescription": "La app usa la cámara para reconocer el rostro y registrar la asistencia. No se guardan fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.corbana.appfinca",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para registrar dónde se toma cada racimo de la precalibración.",
          "locationAlwaysAndWhenInUsePermission": "La app guarda tu recorrido durante la precalibración aunque bloquees el teléfono.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para reconocer el rostro y registrar la asistencia. No se guardan fotos."
        }
      ],
      "expo-screen-orientation",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ecf6445-2917-414c-9491-0bdddc604ecc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2ecf6445-2917-414c-9491-0bdddc604ecc"
    }
  }
}
